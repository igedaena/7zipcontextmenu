# Only reviewed source and documentation enter the repository.
/*
!/.gitignore
!/.gitattributes
!/.vsconfig
!/CMakeLists.txt
!/README.md
!/THIRD_PARTY_NOTICES.md
!/LICENSE
!/NOTICE.txt
!/SOURCE.txt
!/src/
!/scripts/
!/portable/
!/installer/
!/tools/
!/assets/
!/docs/

/assets/*
!/assets/README.md
!/assets/sevenzip-extension.ico
!/assets/sevenzip-extension.png
!/assets/sevenzip-extension-source.png

/docs/*
!/docs/BUILD.md
!/docs/RELEASES.md
!/docs/DISTRIBUTION.md

# Local setup launcher used by the excluded root CMD wrappers.
/scripts/Launch-Setup.ps1

# Generated files and private work records, including nested copies.
.tools/
.review/
.git/
.agents/
.codex/
.aws/
.vs/
build/
out/
dist/
archive/
chat-exports/
HANDOFF*.md
*.user
*.suo
*.log
*.pdb
*.obj
*.ilk
*.tmp
.env
.env.*
*.pem
*.key
